generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String               @id @default(cuid())
  name             String
  email            String               @unique
  passwordHash     String
  role             String               @default("CUSTOMER") // ADMIN, STAFF, CUSTOMER
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  resetTokens      PasswordResetToken[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  paymentsRecorded Payment[]            @relation("StaffPayments")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Product {
  id                  String                 @id @default(cuid())
  name                String
  type                String                 @default("SOFTWARE") // SERVICE, SOFTWARE, HARDWARE
  salesPrice          Float
  costPrice           Float
  notes               String?
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  variants            ProductVariant[]
  subscriptionLines   SubscriptionLine[]
  invoiceLines        InvoiceLine[]
  templateLines       QuotationTemplateLine[]
  discountRules       DiscountRule[]
}

model ProductVariant {
  id                String             @id @default(cuid())
  productId         String
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeName     String
  attributeValue    String
  priceAdjustment   Float              @default(0.0)
  createdAt         DateTime           @default(now())
  subscriptionLines SubscriptionLine[]
}

model Plan {
  id                 String              @id @default(cuid())
  name               String
  billingFrequency   String              @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, YEARLY
  price              Float
  minQuantity        Int                 @default(1)
  startDate          DateTime?
  endDate            DateTime?
  autoCloseOnEnd     Boolean             @default(true)
  allowEarlyClose    Boolean             @default(true)
  allowPause         Boolean             @default(true)
  renewable          Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  subscriptions      Subscription[]
  quotationTemplates QuotationTemplate[]
}

model QuotationTemplate {
  id           String                  @id @default(cuid())
  name         String
  validityDays Int                     @default(30)
  planId       String?
  plan         Plan?                   @relation(fields: [planId], references: [id])
  createdAt    DateTime                @default(now())
  lines        QuotationTemplateLine[]
}

model QuotationTemplateLine {
  id         String            @id @default(cuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id])
  quantity   Int               @default(1)
}

model Subscription {
  id                 String             @id @default(cuid())
  subscriptionNumber String             @unique
  customerId         String
  customer           User               @relation(fields: [customerId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             String             @default("DRAFT") // DRAFT, QUOTATION, CONFIRMED, ACTIVE, PAUSED, CLOSED
  startDate          DateTime           @default(now())
  expiryDate         DateTime?
  nextBillingDate    DateTime?
  paymentTerms       String             @default("Due on receipt")
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  lines              SubscriptionLine[]
  invoices           Invoice[]
  discounts          DiscountRule[]

  @@index([customerId])
  @@index([nextBillingDate])
  @@index([status])
}

model SubscriptionLine {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  quantity       Int             @default(1)
  unitPrice      Float
  taxRate        Float           @default(0.0)
  amount         Float
}

model TaxRule {
  id        String   @id @default(cuid())
  name      String
  rate      Float    // e.g. 10 for 10%
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model DiscountRule {
  id                String         @id @default(cuid())
  code              String         @unique
  description       String?
  type              String         @default("PERCENTAGE") // FIXED, PERCENTAGE
  value             Float
  minPurchaseAmount Float?
  minQuantity       Int?
  startDate         DateTime?
  endDate           DateTime?
  usageLimit        Int?
  timesUsed         Int            @default(0)
  scope             String         @default("SUBSCRIPTION") // PRODUCT, SUBSCRIPTION
  productId         String?
  product           Product?       @relation(fields: [productId], references: [id])
  subscriptionId    String?
  subscription      Subscription?  @relation(fields: [subscriptionId], references: [id])
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
}

model Invoice {
  id                 String        @id @default(cuid())
  invoiceNumber      String        @unique
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  customerId         String
  customer           User          @relation(fields: [customerId], references: [id])
  status             String        @default("DRAFT") // DRAFT, CONFIRMED, PAID, CANCELLED
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  subtotal           Float         @default(0.0)
  taxAmount          Float         @default(0.0)
  discountAmount     Float         @default(0.0)
  totalAmount        Float         @default(0.0)
  amountPaid         Float         @default(0.0)
  balanceDue         Float         @default(0.0)
  paymentStatus      String        @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  lines              InvoiceLine[]
  payments           Payment[]

  @@index([status, dueDate])
  @@index([customerId])
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  description    String
  quantity       Int      @default(1)
  unitPrice      Float
  taxRate        Float    @default(0.0)
  discountAmount Float    @default(0.0)
  totalAmount    Float
}

model Payment {
  id               String        @id @default(cuid())
  paymentNumber    String        @unique
  invoiceId        String
  invoice          Invoice       @relation(fields: [invoiceId], references: [id])
  amount           Float
  method           String        @default("CREDIT_CARD") // CREDIT_CARD, BANK_TRANSFER, PAYPAL, CASH, CHEQUE
  paymentDate      DateTime      @default(now())
  notes            String?
  recordedByUserId String?
  recordedBy       User?         @relation("StaffPayments", fields: [recordedByUserId], references: [id])
  createdAt        DateTime      @default(now())

  @@index([invoiceId])
}
